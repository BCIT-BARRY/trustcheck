{
  "name": "trustcheck",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "changeset": "changeset",
    "version": "node scripts/bbdevhq-version.mjs",
    "commitlint": "commitlint --config bbdevhq-commitlint.config.cjs",
